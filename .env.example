# Copy to .env.local and fill in from Firebase console → Project settings → Your apps (Web).
# These are public client identifiers, not secrets — App Check is what protects the backend.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_MEASUREMENT_ID=

# App Check (reCAPTCHA Enterprise site key). Required for production.
VITE_RECAPTCHA_ENTERPRISE_SITE_KEY=

# App Check debug token.
# - Local dev (`npm run dev`): leave empty and the SDK prints a fresh token to the
#   console; register it under App Check → Apps → Manage debug tokens.
#   Or paste an already-registered token here to reuse it.
# - Hosted testing builds: set a registered token here. NEVER set this for a
#   public production build — it lets anyone bypass App Check.
VITE_APPCHECK_DEBUG_TOKEN=

# Optional model overrides.
VITE_CLOUD_MODEL_FAST=gemini-3.5-flash-lite
VITE_CLOUD_MODEL_COMPLEX=gemini-3.6-flash

# Image creation (needs Firebase Blaze plan). Daily per-browser allowance.
VITE_CLOUD_MODEL_IMAGE=gemini-3.1-flash-image-preview
VITE_IMAGE_DAILY_LIMIT=5
